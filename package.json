{
  "name": "tacoza-tray",
  "version": "1.0.0",
  "description": "Cross-platform local hardware bridge for bill printing in restaurants",
  "main": "main.js",
  "author": {
    "name": "Tacoza",
    "email": "support@tacoza.io"
  },
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "test:security": "node tests/security/pentest.js",
    "test:load":     "node tests/load/loadtest.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "node-hid": "^3.1.0",
    "serialport": "^12.0.0",
    "usb": "^2.13.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "node-gyp": "^12.4.0"
  },
  "overrides": {
    "node-gyp": "^12.4.0"
  },
  "build": {
    "appId": "io.tacoza.tray",
    "productName": "Tacoza Tray",
    "icon": "assets/icon",
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [],
    "artifactName": "Tacoza-Tray-${version}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "nsis": {
      "artifactName": "Tacoza-Tray-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Tacoza-Tray-${version}-portable.${ext}"
    },
    "deb": {
      "artifactName": "tacoza-tray_${version}_${arch}.${ext}"
    }
  }
}
